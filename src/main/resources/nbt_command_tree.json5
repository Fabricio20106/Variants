{
  "nbt": {
    "<target>": {
      "custom_model_data": { // "CustomModelData" integer tag
        "type": "integer",
        "min": 0 // 0 removes the tag
      },
      "display:name": { // "display.Name" JSON tag
        "text": [
          "text",
          "translate",
          "score",
          "nbt",
          "keybind",
          {
            "type": "string"
          }
        ],
        "style": {
          "color": {
            "type": [
              "integer",
              "all_color_text_formatting_types"
            ]
          },
          "bold": "boolean",
          "italic": "boolean",
          "underlined": "boolean",
          "strikethrough": "boolean",
          "obfuscated":"boolean",
          "font": "location",
          "insertion": "string",
          "click_event": {},
          "hover_event": {}
        }
      },
      "display:color": [ // "display.color" integer tag used by leather and wool armor
        {
          "type": "integer",
          "min": 0,
          "max": 16777216
        },
        {
          "type": "string",
          "prefix": '#'
        },
        {
          "red": {
            "type": "integer",
            "min": 0,
            "max": 255
          },
          "green": {
            "type": "integer",
            "min": 0,
            "max": 255
          },
          "blue": {
            "type": "integer",
            "min": 0,
            "max": 255
          }
        }
      ],
      "crossbow:charged": { // "Charged" boolean tag of Crossbows
        "type": "boolean"
      },
      "crossbow:charged_projectiles": { // "ChargedProjectiles" list tag of Crossbows
        "type": "list",
        "list_type": "item_stack"
      },
      "potion:potion": { // "Potion" string tag of all potions and Tipped Arrows
        "type": "registry_provider",
        "registry": "minecraft:potion"
      },
      "potion:custom_potion_color": { // "CustomPotionColor" integer tag of all potions and Tipped Arrows
        "type": "integer",
        "min": 0,
        "max": 16777215
      },
      "potion:custom_potion_effects": { // "CustomPotionEffects" list tag of all potions and Tipped Arrows
        "type": "registry_list",
        "registry": "minecraft:effect"
      },
      "map:map_id": { // "map" integer tag of Filled Maps
        "type": "integer",
        "min": 0
      },
      "map:map_color": { // "display.MapColor" integer tag of Filled Maps
        "type": "integer",
        "min": 0,
        "max": 16777215
      },
      "map:map_scale_direction": { // Internal "map_scale_direction" integer tag of Filled Maps, used by Cartography Tables
        "type": "integer"
      },
      "map:map_to_lock": { // Internal "map_to_lock" boolean tag of Filled Maps, used by Cartography Tables
        "type": "boolean"
      },
      "map:decorations": { // "Decorations" list tag of Filled Maps
        "add": {
          "arguments": [
            {
              "id": "string",
              "type": {
                "type": "string",
                "values": []
              },
              "x": "block_pos",
              "z": "block_pos",
              "rotation": {
                "type": "double",
                "min": 0,
                "max": 360,
                "default": 180
              }
            }
          ]
        }
      },
      "general:damage": { // "Damage" integer tag
        "type": "integer"
      },
      "general:unbreakable": { // "Unbreakable" boolean tag
        "type": "boolean"
      },
      "general:hide_flags": { // "HideFlags" integer tag
        "type": "string_to_int_map",
        "values": {
          "enchantments": 1,
          "attribute_modifiers": 2,
          "unbreakable": 4,
          "can_destroy": 8,
          "can_place_on": 16,
          "miscellaneous": 32,
          "dyed": 64,
        },
        "integer_max": 127
      },
      "general:can_place_on": { // "CanPlaceOn" list tag
        "add": {
          "type": "minecraft:block_predicate_argument"
        },
        "remove": {
          "type": "minecraft:block_predicate_argument"
        }
      },
      "general:can_destroy": { // "CanDestroy" list tag
        "add": {
          "type": "minecraft:block_predicate_argument"
        },
        "remove": {
          "type": "minecraft:block_predicate_argument"
        }
      },
      "creative_mode_tab:custom_creative_lock": { // "CustomCreativeLock" compound tag of the paper items in the Saved Items tab
        "type": "compound"
      },
      "tropical_fish_bucket:bucket_variant": { // "BucketVariantTag" 4-byte integer tag of Buckets of Tropical Fish
        "base_color": {
          "type": "dye_color",
          "pattern_color": {
            "type": "dye_color",
            "fish_type": {
              "type": "list",
              "values": [
                "flopper",
                "glitter",
                "betty",
                "stripey",
                "blockfish",
                "clayfish",
                "kob",
                "snooper",
                "brinely",
                "sunstreak",
                "dasher",
                "spotty"
              ],
            }
          }
        }
      },
      "written_book:resolved": { // "resolved" boolean tag of Written Books
        "type": "boolean"
      },
      "written_book:author": { // "author" string tag of Written Books
        "type": "string"
      },
      "written_book:title": { // "title" string tag of Written Books
        "type": "string"
      },
      "written_book:generation": { // "generation" integer tag of Written Books
        "type": "string",
        "values": ["original", "copy_of_original", "copy_of_copy", "tattered"]
      },
      "knowledge_book:recipes": { // "Recipes" list tag of Knowledge Books
        "add": {
          "type": "minecraft:recipe_provider"
        },
        "remove": {
          "type": "minecraft:recipe_provider"
        }
      },
      "compass:tracking_lodestone": { // "LodestoneTracked" boolean tag of Compasses
        "type": "boolean"
      },
      "compass:lodestone_pos": { // "LodestonePos" compound tag of Compasses
        "type": "minecraft:column_pos_argument"
      },
      "compass:lodestone_dimension": { // "LodestoneDimension" string tag of Compasses
        "type": "registry_provider",
        "registry": "minecraft:dimension"
      },
      "debug_stick:debug_property": { // "DebugProperty" compound tag of Debug Sticks
        "add": {
          "type": "minecraft:block_state_argument"
        },
        "remove": {
          "type": "minecraft:block_state_argument"
        }
      },
      "player_head:skull_owner": { // "SkullOwner" string/compound tag of Player Heads,
        "type": "string"
      },
      "firework_rocket:flight_duration": { // "Fireworks.Flight" byte tag of Firework Rockets
        "type": "integer"
      },
      "firework_star:explosions": { // "Explosions" compound tag of Firework Stars
        "arguments": {
          "type": "string; values=[small_ball, large_ball, star, creeper, burst]",
          "color": "[integer; min=0; max=16777215]; [string; source=all_color_text_formatting_codes]", // Can be specific as an integer or as a string of available colors
          "fade_color": "integer; min=0; max=16777215", // Can be specific as an integer or as a string of available colors
          "twinkle": "boolean",
          "trail": "boolean"
        }
      }
    }
  }
}